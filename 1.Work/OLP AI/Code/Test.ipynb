    "from torchvision import transforms"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "2fae050d-bef2-4925-a373-715a1b4f8e71",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "\u001b[31mInit signature:\u001b[39m\n",
       "transforms.RandAugment(\n",
       "    num_ops: int = \u001b[32m2\u001b[39m,\n",
       "    magnitude: int = \u001b[32m9\u001b[39m,\n",
       "    num_magnitude_bins: int = \u001b[32m31\u001b[39m,\n",
       "    interpolation: torchvision.transforms.functional.InterpolationMode = <InterpolationMode.NEAREST: \u001b[33m'nearest'\u001b[39m>,\n",
       "    fill: list[float] | \u001b[38;5;28;01mNone\u001b[39;00m = \u001b[38;5;28;01mNone\u001b[39;00m,\n",
       ") -> \u001b[38;5;28;01mNone\u001b[39;00m\n",
       "\u001b[31mSource:\u001b[39m        \n",
       "\u001b[38;5;28;01mclass\u001b[39;00m RandAugment(torch.nn.Module):\n",
       "    \u001b[33mr\"\"\"RandAugment data augmentation method based on\u001b[39m\n",
       "\u001b[33m    `\"RandAugment: Practical automated data augmentation with a reduced search space\"\u001b[39m\n",
       "\u001b[33m    <https://arxiv.org/abs/1909.13719>`_.\u001b[39m\n",
       "\u001b[33m    If the image is torch Tensor, it should be of type torch.uint8, and it is expected\u001b[39m\n",
       "\u001b[33m    to have [..., 1 or 3, H, W] shape, where ... means an arbitrary number of leading dimensions.\u001b[39m\n",
       "\u001b[33m    If img is PIL Image, it is expected to be in mode \"L\" or \"RGB\".\u001b[39m\n",
       "\n",
       "\u001b[33m    Args:\u001b[39m\n",
       "\u001b[33m        num_ops (int): Number of augmentation transformations to apply sequentially.\u001b[39m\n",
       "\u001b[33m        magnitude (int): Magnitude for all the transformations.\u001b[39m\n",
       "\u001b[33m        num_magnitude_bins (int): The number of different magnitude values.\u001b[39m\n",
       "\u001b[33m        interpolation (InterpolationMode): Desired interpolation enum defined by\u001b[39m\n",
       "\u001b[33m            :class:`torchvision.transforms.InterpolationMode`. Default is ``InterpolationMode.NEAREST``.\u001b[39m\n",
       "\u001b[33m            If input is Tensor, only ``InterpolationMode.NEAREST``, ``InterpolationMode.BILINEAR`` are supported.\u001b[39m\n",
       "\u001b[33m        fill (sequence or number, optional): Pixel fill value for the area outside the transformed\u001b[39m\n",
       "\u001b[33m            image. If given a number, the value is used for all bands respectively.\u001b[39m\n",
       "\u001b[33m    \"\"\"\u001b[39m\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m __init__(\n",
       "        self,\n",
       "        num_ops: int = \u001b[32m2\u001b[39m,\n",
       "        magnitude: int = \u001b[32m9\u001b[39m,\n",
       "        num_magnitude_bins: int = \u001b[32m31\u001b[39m,\n",
       "        interpolation: InterpolationMode = InterpolationMode.NEAREST,\n",
       "        fill: Optional[list[float]] = \u001b[38;5;28;01mNone\u001b[39;00m,\n",
       "    ) -> \u001b[38;5;28;01mNone\u001b[39;00m:\n",
       "        super().__init__()\n",
       "        self.num_ops = num_ops\n",
       "        self.magnitude = magnitude\n",
       "        self.num_magnitude_bins = num_magnitude_bins\n",
       "        self.interpolation = interpolation\n",
       "        self.fill = fill\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m _augmentation_space(self, num_bins: int, image_size: tuple[int, int]) -> dict[str, tuple[Tensor, bool]]:\n",
       "        \u001b[38;5;28;01mreturn\u001b[39;00m {\n",
       "            \u001b[38;5;66;03m# op_name: (magnitudes, signed)\u001b[39;00m\n",
       "            \u001b[33m\"Identity\"\u001b[39m: (torch.tensor(\u001b[32m0.0\u001b[39m), \u001b[38;5;28;01mFalse\u001b[39;00m),\n",
       "            \u001b[33m\"ShearX\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.3\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"ShearY\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.3\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"TranslateX\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m150.0\u001b[39m / \u001b[32m331.0\u001b[39m * image_size[\u001b[32m1\u001b[39m], num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"TranslateY\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m150.0\u001b[39m / \u001b[32m331.0\u001b[39m * image_size[\u001b[32m0\u001b[39m], num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Rotate\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m30.0\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Brightness\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.9\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Color\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.9\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Contrast\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.9\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Sharpness\"\u001b[39m: (torch.linspace(\u001b[32m0.0\u001b[39m, \u001b[32m0.9\u001b[39m, num_bins), \u001b[38;5;28;01mTrue\u001b[39;00m),\n",
       "            \u001b[33m\"Posterize\"\u001b[39m: (\u001b[32m8\u001b[39m - (torch.arange(num_bins) / ((num_bins - \u001b[32m1\u001b[39m) / \u001b[32m4\u001b[39m)).round().int(), \u001b[38;5;28;01mFalse\u001b[39;00m),\n",
       "            \u001b[33m\"Solarize\"\u001b[39m: (torch.linspace(\u001b[32m255.0\u001b[39m, \u001b[32m0.0\u001b[39m, num_bins), \u001b[38;5;28;01mFalse\u001b[39;00m),\n",
       "            \u001b[33m\"AutoContrast\"\u001b[39m: (torch.tensor(\u001b[32m0.0\u001b[39m), \u001b[38;5;28;01mFalse\u001b[39;00m),\n",
       "            \u001b[33m\"Equalize\"\u001b[39m: (torch.tensor(\u001b[32m0.0\u001b[39m), \u001b[38;5;28;01mFalse\u001b[39;00m),\n",
       "        }\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m forward(self, img: Tensor) -> Tensor:\n",
       "        \u001b[33m\"\"\"\u001b[39m\n",
       "\u001b[33m            img (PIL Image or Tensor): Image to be transformed.\u001b[39m\n",
       "\n",
       "\u001b[33m        Returns:\u001b[39m\n",
       "\u001b[33m            PIL Image or Tensor: Transformed image.\u001b[39m\n",
       "\u001b[33m        \"\"\"\u001b[39m\n",
       "        fill = self.fill\n",
       "        channels, height, width = F.get_dimensions(img)\n",
       "        \u001b[38;5;28;01mif\u001b[39;00m isinstance(img, Tensor):\n",
       "            \u001b[38;5;28;01mif\u001b[39;00m isinstance(fill, (int, float)):\n",
       "                fill = [float(fill)] * channels\n",
       "            \u001b[38;5;28;01melif\u001b[39;00m fill \u001b[38;5;28;01mis\u001b[39;00m \u001b[38;5;28;01mnot\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n",
       "                fill = [float(f) \u001b[38;5;28;01mfor\u001b[39;00m f \u001b[38;5;28;01min\u001b[39;00m fill]\n",
       "\n",
       "        op_meta = self._augmentation_space(self.num_magnitude_bins, (height, width))\n",
       "        \u001b[38;5;28;01mfor\u001b[39;00m _ \u001b[38;5;28;01min\u001b[39;00m range(self.num_ops):\n",
       "            op_index = int(torch.randint(len(op_meta), (\u001b[32m1\u001b[39m,)).item())\n",
       "            op_name = list(op_meta.keys())[op_index]\n",
       "            magnitudes, signed = op_meta[op_name]\n",
       "            magnitude = float(magnitudes[self.magnitude].item()) \u001b[38;5;28;01mif\u001b[39;00m magnitudes.ndim > \u001b[32m0\u001b[39m \u001b[38;5;28;01melse\u001b[39;00m \u001b[32m0.0\u001b[39m\n",
       "            \u001b[38;5;28;01mif\u001b[39;00m signed \u001b[38;5;28;01mand\u001b[39;00m torch.randint(\u001b[32m2\u001b[39m, (\u001b[32m1\u001b[39m,)):\n",
       "                magnitude *= -\u001b[32m1.0\u001b[39m\n",
       "            img = _apply_op(img, op_name, magnitude, interpolation=self.interpolation, fill=fill)\n",
       "\n",
       "        \u001b[38;5;28;01mreturn\u001b[39;00m img\n",
       "\n",
       "    \u001b[38;5;28;01mdef\u001b[39;00m __repr__(self) -> str:\n",
       "        s = (\n",
       "            f\"{self.__class__.__name__}(\"\n",
       "            f\"num_ops={self.num_ops}\"\n",
       "            f\", magnitude={self.magnitude}\"\n",
       "            f\", num_magnitude_bins={self.num_magnitude_bins}\"\n",
       "            f\", interpolation={self.interpolation}\"\n",
       "            f\", fill={self.fill}\"\n",
       "            f\")\"\n",
       "        )\n",
       "        \u001b[38;5;28;01mreturn\u001b[39;00m s\n",
       "\u001b[31mFile:\u001b[39m           ~/Documents/Obsidian/1.Work/OLP AI/.venv/lib/python3.14/site-packages/torchvision/transforms/autoaugment.py\n",
       "\u001b[31mType:\u001b[39m           type\n",
       "\u001b[31mSubclasses:\u001b[39m     "
      ]
     },
